    "lucide-react": "^1.33.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.85.0",
    "react-i18next": "^17.0.12",
    "react-router-dom": "^7.18.2",
    "react-virtuoso": "^4.18.12",
