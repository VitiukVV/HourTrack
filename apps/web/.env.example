# HourTrack -- env.example
#
# Copy to `.env.local` and fill in the values. The Vite build reads variables
# prefixed with `VITE_` at build time; runtime access is `import.meta.env.*`.
#
# Google Identity Services OAuth 2.0 Client ID. Obtain from Google Cloud Console
# (see `docs/google-cloud-setup.md` for the full step-by-step).
#
# Format: `<digits>-<hash>.apps.googleusercontent.com`
VITE_GOOGLE_CLIENT_ID=your-client-id-here.apps.googleusercontent.com
