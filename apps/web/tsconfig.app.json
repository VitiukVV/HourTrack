{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "declaration": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "outDir": "./dist",
    "rootDir": ".",
    "types": ["vite/client", "vite-plugin-pwa/client"],
    "paths": {
      // App-local source alias; workspace packages resolve via pnpm symlinks
      // under node_modules/@hourtrack/* (see comment in tsconfig.base.json).
      "@/*": ["./src/*"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "src/**/*.json"]
}
