{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "globalDependencies": ["tsconfig.base.json", ".prettierrc", "eslint.config.js", "pnpm-lock.yaml"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "!**/*.md", "!e2e/**", "!playwright.config.ts"],
      "outputs": ["dist/**", "build/**", ".vite/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "inputs": ["$TURBO_DEFAULT$", "!**/*.md"],
      "outputs": []
    },
    "typecheck": {
      "inputs": ["$TURBO_DEFAULT$", "!**/*.md"],
      "outputs": []
    },
    "test": {
      "inputs": ["$TURBO_DEFAULT$", "!**/*.md", "!e2e/**", "!playwright.config.ts"],
      "outputs": []
    },
    "test:coverage": {
      "inputs": ["$TURBO_DEFAULT$", "!**/*.md", "!e2e/**", "!playwright.config.ts"],
      "outputs": ["coverage/**"]
    }
  }
}
